# Reap key intentionally blank. Never commit a filled .env.
PAYMENT_MODE=mock
REAP_API_KEY=
REAP_BASE_URL=https://sg.sandbox.api.reap.global
REAP_VERSION=2025-02-14
# Sandbox contact placeholders accepted in the local NTU demo quote.
BOOKPOOL_PURCHASER_EMAIL=bookpool.test@example.com
BOOKPOOL_SHIPPING_NAME=Book Pool
BOOKPOOL_SHIPPING_PHONE=+6591234567
PUBLIC_BASE_URL=http://localhost:8000
# Reap requires HTTPS. For a Telegram demo, use https://t.me/<your_bot_username>.
PAYMENT_RETURN_URL=
DATABASE_URL=sqlite:///./data/bookpool.db
# Generate a private service key for teammates; run_local.py generates one locally.
BOOKPOOL_SERVICE_API_KEY=
# Test PAN/expiry/CVV are entered only on Reap's hosted enrollment page.
# No card-detail variables or database columns exist in BookPool.
